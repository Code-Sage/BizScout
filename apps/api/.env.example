NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_VERSION=dev

DATABASE_URL=postgres://bizscout:bizscout@localhost:5432/bizscout
DATABASE_SSL=false
DATABASE_POOL_MAX=5
RUN_MIGRATIONS_ON_BOOT=true

CORS_ORIGINS=http://localhost:5173

# Real target. Swap for http://localhost:8080/anything to work offline against docker compose.
HTTPBIN_URL=https://httpbin.org/anything
PING_INTERVAL_MS=300000
PING_TIMEOUT_MS=10000
SCHEDULER_ENABLED=true

# Protects POST /api/internal/*. Generate with: openssl rand -hex 24
INTERNAL_API_TOKEN=
